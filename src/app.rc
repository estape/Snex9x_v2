#include <winver.h>

// Primary executable icon (lowest resource ID so Windows Explorer & Taskbar pick it first)
101 ICON "../assets/snex9x.ico"

// Also alias to IDI_APPLICATION (32512) so LoadIcon(hInstance, IDI_APPLICATION) finds it automatically
32512 ICON "../assets/snex9x.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     2,0,0,0
PRODUCTVERSION  2,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Snex9x Project"
            VALUE "FileDescription",  "Snex9x v2 - Super Nintendo Entertainment System Emulator"
            VALUE "FileVersion",      "2.0.0.0"
            VALUE "InternalName",     "Snex9x_v2"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Snex9x Project"
            VALUE "OriginalFilename", "Snex9x_v2.exe"
            VALUE "ProductName",      "Snex9x v2"
            VALUE "ProductVersion",   "2.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
